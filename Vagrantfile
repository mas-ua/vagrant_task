# -*- mode: ruby -*-
# vi: set ft=ruby :
# Вышеуказанные строки — это специальные маркеры (modelines) для текстовых редакторов (например, Emacs и Vim),
# которые указывают, что данный файл написан на языке Ruby, и включают для него соответствующую подсветку синтаксиса.

# Определение Shell-скрипта (переменная $install_deps) для автоматической настройки операционной системы.
# Используется синтаксис Heredoc (<<-'SHELL'), позволяющий писать многострочный код Bash прямо внутри Ruby-файла.
$install_deps = <<-'SHELL'
  # Обновление локального индекса пакетов apt, чтобы система знала о самых свежих версиях программ.
  sudo apt-get update
  
  # Автоматическая (флаг -y отключает запросы на подтверждение) установка пакета OpenJDK версии 17, 
  # необходимого для запуска Java-приложений (включая Spring Boot).
  sudo apt-get install -y openjdk-17-jdk
SHELL

# Основной блок конфигурации Vagrant. Версия "2" указывает на актуальный стандарт синтаксиса Vagrant 2.x.
Vagrant.configure("2") do |config|
  
  # Выбор официального базового образа операционной системы. В данном случае — 64-битная Ubuntu 22.04 LTS (Jammy Jellyfish).
  config.vm.box = "ubuntu/jammy64"
  
  # Строгая фиксация конкретной версии базового образа (сборка от 02.10.2024), чтобы избежать неожиданных проблем при обновлении образов в будущем.
  config.vm.box_version = "20241002.0.0"
  
  # Проброс портов (Port Forwarding): перенаправляет входящий трафик с порта 8080 вашего физического компьютера (хоста)
  # на внутренний порт 8080 виртуальной машины (гостя). Это позволит открывать Spring Boot приложение по адресу http://localhost:8080.
  config.vm.network "forwarded_port", guest: 8080, host: 8080
  
  # Настройка изолированной приватной сети (Host-only). Назначает виртуальной машине фиксированный статический IP-адрес.
  # Через него хост-компьютер и виртуалка могут общаться напрямую в отдельной подсети.
  config.vm.network "private_network", ip: "192.168.100.100"
  
  # Блок тонкой настройки параметров виртуальной машины непосредственно внутри гипервизора VirtualBox.
  config.vm.provider "virtualbox" do |vb|
    
    # Включение графического интерфейса. При значении true при запуске виртуалки откроется стандартное окно VirtualBox с экраном загрузки ОС.
    vb.gui = true
    
    # Выделение объема оперативной памяти (RAM) для виртуальной машины. Задано 4096 Мегабайт (4 Гигабайта).
    vb.memory = "4096"
    
    # Выделение количества ядер виртуального процессора (CPU) для обеспечения стабильной параллельной сборки проекта.
    vb.cpus = 2
  end
  
  # Стадия Provisioning: запуск Shell-скрипта, сохраненного ранее в переменной $install_deps.
  # Этот скрипт выполняется один раз при самом первом создании машины (команда vagrant up) от имени root.
  config.vm.provision "shell", inline: $install_deps
  
  # Определение триггера (события), которое автоматически сработает ПОСЛЕ полной загрузки и настройки машины (:up).
  config.trigger.after :up do |trigger|
    
    # Имя триггера для логирования и отображения в консоли Vagrant.
    trigger.name = "Start Spring Boot application"
    
    # Инструкция запустить команду удаленно (внутри гостевой виртуальной машины, а не на вашем ПК).
    trigger.run_remote = {
            inline: "cd /vagrant && ./gradlew bootRun",
          }
  end
end
